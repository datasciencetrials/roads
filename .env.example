# Variable names only. Never put real credentials in this tracked example.
# For local ETL, inject these from an encrypted user or CI secret store.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-from-vault

