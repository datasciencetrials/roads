# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment files are plaintext and must never be committed.
# Put actual secrets in an encrypted secret store and inject them at runtime.
**/.env
**/.env.*
!**/.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Never commit giant binaries / GIS installers / DBs (they break GitHub pushes)
arcgis-src/
*.rar
*.db
offline-tiles/
public/s-photos/
gis-enterprise/.env
